{
  "name": "@0disoft/openfeature-local-provider",
  "version": "2.0.0-alpha.7",
  "description": "Local OpenFeature provider for JSON/YAML flag snapshots, CLI validation, file reload/watch, typed evaluation, environment overrides, bucketing, replay fixtures, redacted audit events, and lockable rotating file audit sinks.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0disoft/openfeature-local-provider-audit.git",
    "directory": "packages/local-provider"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openfeature-local-provider": "./bin/openfeature-local-provider.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "pack:check": "pnpm run build && publint && attw --pack .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.22.0"
  },
  "devDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@types/semver": "^7.8.0"
  },
  "keywords": [
    "openfeature",
    "feature-flags",
    "provider",
    "local",
    "testing"
  ],
  "dependencies": {
    "semver": "^7.8.5",
    "yaml": "^2.9.1"
  }
}
